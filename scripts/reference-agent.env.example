# Copy to ~/.agent-rails/reference-agent/reference-agent.env (never commit the copy).
# scripts/reference-agent.sh sources this file.

RPC_URL=https://api.devnet.solana.com
OUT_DIR=${HOME}/.agent-rails/reference-agent

# Public treasury (workflow "Cofre devnet" in ~/.agent-rails/dashboard.json).
TREASURY=BTE45zKpHiWMTwaPmShaUBq2cnA6XUc8KhgxnufSnz3w
POLICY_NAME=dashboard-demo

# Filled in after `agent-rails session create` (see docs/runbooks/reference-agent.md).
# SESSION=
# SESSION_KEYPAIR=${OUT_DIR}/reference-agent-session-keypair.json

# Operator wallet — funds deposits, session create, and tx fees. Not used to sign payments.
# WALLET=/path/to/devnet-ci-keypair.json
# FEE_PAYER_KEYPAIR=${WALLET}

# Registered allowlist label (mock vendor receipt address on devnet).
DESTINATION=demo
AMOUNT=0.00001
DENY_AMOUNT=0.03

# JSONL sink (same path as AGENT_RAILS_SINK in the MCP snippet).
SINK=${OUT_DIR}/payments.jsonl

# ~2100 settlements in 16 days at one tick every 11 minutes; ~31 denials at 1/68 ticks.
INTERVAL_SEC=660
DENY_EVERY=68

# Optional override; defaults to packages/cli/dist/cli.js under the repo root.
# CLI=
