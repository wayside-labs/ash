{
  "name": "@agent-rails/client",
  "version": "0.1.0",
  "description": "Codama-generated @solana/kit client for the Agent Rails Solana program.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/agent-rails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/agent-rails.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/agent-rails/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/generated/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/generated"
  ],
  "scripts": {
    "codegen": "codama run js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/kit": "^8.2.0",
    "@solana/program-client-core": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "codama": "^1.6.2",
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.4.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
