# Anthropic key for the chat. Optional — you can also add it in the UI under
# My APIs, which stores it in ~/.agent-rails/dashboard.json instead of here.
# Without either, /api/chat answers in demo mode.
ANTHROPIC_API_KEY=

# Platform-paid chat through OpenRouter: users chat without a key of their own.
# Server-only, never NEXT_PUBLIC_*. With Supabase configured only signed-in
# sessions may use it; in local JSON mode anyone who can reach this server can,
# so set it there only for development. BYO keys above still take precedence.
OPENROUTER_API_KEY=
# Optional attribution sent to OpenRouter (HTTP-Referer / X-OpenRouter-Title).
# OPENROUTER_SITE_URL=https://your-dashboard.example
# OPENROUTER_APP_TITLE=Agent Rails Dashboard

# Prepaid credit for the platform key (docs/runbooks/chat-credit-billing.md).
# Always on when Supabase is configured; locally, BILLING_ENABLED=true opts in.
# BILLING_ENABLED=true
# Service fee on top of model cost, in basis points: 2000 = 20%. Max 10000.
# BILLING_MARKUP_BPS=2000
# Free credit each org gets once, in USD. Unset = none. Anything below one
# worst-case reply (~$0.12 on Sonnet 5.5) grants credit no message can use.
# BILLING_STARTER_CREDIT_USD=0.50

# Where the dashboard keeps its JSON document. Defaults to ~/.agent-rails
AGENT_RAILS_HOME=

# --- Hosted tenancy (ADR-017). Omit all of these for local JSON-only mode. ---
NEXT_PUBLIC_SUPABASE_URL=
# Either name works; Supabase dashboard may label this "anon" or "publishable".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — bootstrap (account/org/membership/platform wallet) on first sign-in.
SUPABASE_SERVICE_ROLE_KEY=
# Public origin the auth redirects go back to. Required behind a tunnel or proxy, where the
# request URL is the loopback the server listens on.
# DASHBOARD_PUBLIC_URL=https://console.example

# --- Sign-in doors (ADR-024) ---
# Email magic link and Google are configured in the Supabase project, not here: see
# docs/runbooks/email-login-and-platform-wallet.md for the provider switches, the redirect URL
# allowlist, and the magic-link email template that makes links work across browsers.

# --- Platform wallet (ADR-024) ---
# Which provider mints the wallet every account gets at first sign-in. Only `stub` exists:
# a real address whose key is discarded, so no one can ever move funds sent to it and the UI
# says so. An unknown name fails provisioning loudly rather than falling back.
# PLATFORM_WALLET_PROVIDER=stub

# Who may connect Phantom/Solflare/Backpack in hosted mode: `pro` (default) or `everyone`.
# Treasury setup still signs with an external wallet, so a demo deployment that must run the
# bootstrap wizard for free accounts sets `everyone`. Local JSON mode is never gated.
# DASHBOARD_EXTERNAL_WALLETS=pro

# Comma-separated origins allowed to mutate state (CSRF floor). Required in production.
# ALLOWED_ORIGINS=https://your-app.vercel.app
