{
  "name": "@agent-rails/sdk",
  "version": "0.1.0",
  "description": "PaymentIntent builder, preflight, signing and error mapping for Agent Rails.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/agent-rails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/agent-rails.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/agent-rails/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agent-rails/client": "workspace:*",
    "@agent-rails/contract": "workspace:*",
    "@solana/kit": "^8.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
