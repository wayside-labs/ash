{
  "name": "@ash/cli",
  "version": "0.1.0",
  "description": "Operator CLI for ASH treasuries, policies and agent sessions.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/ash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/ash.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/ash/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "ash": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ash/client": "workspace:*",
    "@ash/contract": "workspace:*",
    "@ash/sdk": "workspace:*",
    "@solana/kit": "^8.2.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
