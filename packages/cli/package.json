{
  "name": "@agent-rails/cli",
  "version": "0.1.0",
  "description": "Operator CLI for Agent Rails treasuries, policies and agent sessions.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/agent-rails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/agent-rails.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/agent-rails/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "agent-rails": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./tx/session": "./src/tx/session.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agent-rails/client": "workspace:*",
    "@agent-rails/contract": "workspace:*",
    "@agent-rails/sdk": "workspace:*",
    "@solana/kit": "^8.2.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
