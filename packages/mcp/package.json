{
  "name": "@ash/mcp",
  "version": "0.1.0",
  "description": "stdio MCP server exposing the agent-facing ASH payment tools.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/ash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/ash.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/ash/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "ash-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@ash/client": "workspace:*",
    "@ash/contract": "workspace:*",
    "@ash/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/kit": "^8.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ash/e2e": "workspace:*",
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
