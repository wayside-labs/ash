{
  "name": "@agent-rails/contract",
  "version": "0.1.0",
  "description": "Schemas, reason codes and event types shared by every Agent Rails surface.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wayside-labs/agent-rails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayside-labs/agent-rails.git",
    "directory": "packages/contract"
  },
  "bugs": {
    "url": "https://github.com/wayside-labs/agent-rails/issues"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "payments",
    "guardrails",
    "anchor",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./mints": {
      "types": "./dist/mints.d.ts",
      "import": "./dist/mints.js"
    },
    "./reason-codes": {
      "types": "./dist/reason-codes.d.ts",
      "import": "./dist/reason-codes.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./alerts": {
      "types": "./dist/alerts.d.ts",
      "import": "./dist/alerts.js"
    },
    "./payment-build": {
      "types": "./dist/payment-build.d.ts",
      "import": "./dist/payment-build.js"
    },
    "./outcome": {
      "types": "./dist/outcome.d.ts",
      "import": "./dist/outcome.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./intent-id": {
      "types": "./dist/intent-id.d.ts",
      "import": "./dist/intent-id.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "vitest": "^4.0.0"
  }
}
