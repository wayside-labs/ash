target/
.anchor/
test-ledger/
**/*.rs.bk
node_modules/
dist/
.turbo/
*.tsbuildinfo

# Solana keypairs are raw secret keys; never commit one, wherever it lands.
**/*keypair*.json

# Surfpool simnet logs from the E2E harness
.surfpool/

# Personal Claude Code overrides; .claude/settings.json is the shared one.
.claude/settings.local.json

# Solana RPC URLs routinely carry an API key in the query string, and the MCP server
# is configured entirely from the environment. An agent must never be able to stage one.
.env
.env.*
!.env.example
