target/
# vitest/llvm-cov reports. biome reads this file (useIgnoreFile), so listing it here is
# also what keeps the generated lcov-report HTML out of `pnpm lint`.
coverage/
.anchor/
test-ledger/
**/*.rs.bk
node_modules/
dist/
.turbo/
*.tsbuildinfo

# Solana keypairs are raw secret keys; never commit one, wherever it lands.
**/*keypair*.json

# `agent-rails init` output: generated keys, the per-cluster manifest and the MCP config
# snippet. Per-developer state, and the keys are already covered above.
.agent-rails/

# Surfpool simnet logs from the E2E harness
.surfpool/

# Playwright's own scratch: the isolated AGENT_RAILS_HOME the UI suite writes to,
# plus traces and screenshots from failed runs.
packages/dashboard/.playwright/

# Personal Claude Code overrides; .claude/settings.json is the shared one.
.claude/settings.local.json

# Solana RPC URLs routinely carry an API key in the query string, and the MCP server
# is configured entirely from the environment. An agent must never be able to stage one.
.env
.env.*
!.env.example

# cargo-mutants working directory: rebuilt every run, never reviewed.
mutants.out/
mutants.out.old/

# Working drafts, deliberately ignored by path rather than by directory: `docs/research/`
# carries three committed documents alongside the uncommitted one, and ignoring the folder
# would silently swallow the next real document added to it.
docs/research/agent-orgs-and-defi-mandates.md
docs/strategy/crypto-worlds-fair-playbook.md

# `vercel link` output: project and org ids belonging to whoever ran it, not a shared
# setting. The deploy configuration that IS shared lives in packages/dashboard/vercel.json.
.vercel/

# `supabase link` scratch: project ref and cached version probes, per-developer.
**/supabase/.temp/
