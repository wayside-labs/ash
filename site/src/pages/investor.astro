---
import Base from "../layouts/Base.astro";
import Top from "../components/pitch/Top.astro";
import Investor from "../components/pitch/Investor.astro";
import { getPitch, investorPath } from "../content/pitch";
const lang = "en" as const;
const p = getPitch(lang);
---
<Base lang={lang} title={p.meta.investorTitle} description={p.meta.description} path={investorPath(lang)} altPath={investorPath("pt")} noindex motion={false}>
  <Top lang={lang} alt={investorPath("pt")} />
  <main id="main"><Investor lang={lang} /></main>
</Base>
