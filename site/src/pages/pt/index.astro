---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Pain from "../../components/Pain.astro";
import Momentum from "../../components/Momentum.astro";
import Pay from "../../components/Pay.astro";
import Showcase from "../../components/Showcase.astro";
import Roles from "../../components/Roles.astro";
import Proof from "../../components/Proof.astro";
import Audiences from "../../components/Audiences.astro";
import Objection from "../../components/Objection.astro";
import Closing from "../../components/Closing.astro";
import Footer from "../../components/Footer.astro";
import { getCopy } from "../../content/copy";
const lang = "pt" as const;
const c = getCopy(lang);
---
<Base lang={lang} title={c.meta.title} description={c.meta.description} path="/pt/">
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Showcase lang={lang} />
    <Momentum lang={lang} />
    <Pain lang={lang} />
    <Pay lang={lang} />
    <Roles lang={lang} />
    <Proof lang={lang} />
    <Audiences lang={lang} />
    <Objection lang={lang} />
    <Closing lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
