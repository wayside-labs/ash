---
// The body of a post. splitBody cuts the studio's HTML at the special-block markers: each stretch
// of markup goes in as it is (the studio's sanitizer is the gate; this is the only set:html over
// payload text on the site) and each marker becomes a component. The typography below is written
// against the tags the sanitizer allows and only reaches markup inside .prose, so it never leaks
// into a block's own component.
import type { Lang } from "../../content/copy";
import { splitBody } from "../../lib/blog-body";
import Shortcode from "./shortcodes/Shortcode.astro";
// where: "en/slug", for the build log lines a block may write.
interface Props { html: string; lang: Lang; where: string }
const { html, lang, where } = Astro.props;
const segments = splitBody(html);
---
<div class="body" data-post-body>
  {segments.map((segment) => segment.kind === "html"
    ? <div class="prose" set:html={segment.html} />
    : <Shortcode name={segment.name} lang={lang} where={where} />)}
</div>
<style>
  .body { font-size: 17px; line-height: 1.7; min-width: 0; }
  .body > :global(* + *) { margin-top: 2em; }
  .prose { overflow-wrap: break-word; }
  .prose > :global(* + *) { margin-top: 1.2em; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top: 88px; }
  .prose :global(h2) { font-size: var(--step-3); line-height: 1.2; margin-top: 2em; }
  .prose :global(h3) { font-size: var(--step-2); line-height: 1.3; margin-top: 1.7em; }
  .prose :global(h4) { font-size: var(--step-1); font-weight: 600; line-height: 1.35; margin: 1.5em 0 0; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h2 + *), .prose :global(h3 + *), .prose :global(h4 + *) { margin-top: .7em; }
  /* The underline is what says "link" (colour alone would not, next to --ink), so it has to be
     seen: green at part strength, full under the pointer. */
  .prose :global(a) { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--settle) 55%, transparent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--settle-soft); text-decoration-color: var(--settle); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(del) { color: var(--faint); }
  /* No margin-top here: a list takes the same gap as any block (the rules above), and a rule
     naming ul/ol would outrank them and put the list against the paragraph before it. */
  .prose :global(ul), .prose :global(ol) { margin-bottom: 0; padding-left: 1.4em; }
  .prose :global(li + li), .prose :global(li > ul), .prose :global(li > ol) { margin-top: .45em; }
  .prose :global(li::marker) { color: var(--faint); }
  .prose :global(blockquote) { margin-inline: 0; margin-bottom: 0; padding: 2px 0 2px 20px; border-left: 2px solid var(--line-strong); color: var(--muted); }
  .prose :global(blockquote > * + *) { margin-top: .8em; }
  .prose :global(code) { font-size: .86em; background: var(--elevated); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: .12em .38em; }
  .prose :global(pre) { margin-bottom: 0; padding: 16px 18px; overflow-x: auto; font-size: 14px; line-height: 1.6; color: var(--code-fg); background: var(--sunken); border: 1px solid var(--line-strong); border-radius: var(--radius-lg); }
  .prose :global(pre code) { font-size: inherit; background: none; border: 0; padding: 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.2em 0 0; }
  .prose :global(figure) { margin: 2em 0 0; }
  .prose :global(img) { display: block; max-width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--line-strong); }
  .prose :global(figcaption) { margin-top: 10px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  /* A table wider than the column scrolls inside itself; the page never does. */
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 15px; line-height: 1.5; }
  .prose :global(th), .prose :global(td) { padding: 8px 14px 8px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .prose :global(th) { font-weight: 500; color: var(--muted); border-bottom-color: var(--line-strong); }
  @media (max-width: 620px) { .body { font-size: 16.5px; line-height: 1.65; } .prose :global(h2) { font-size: 1.5rem; } }
</style>
