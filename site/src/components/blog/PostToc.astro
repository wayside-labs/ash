---
// The headings of a post, linked to the ids the studio wrote on its h2 and h3. With fewer than
// two headings there is nothing to navigate, so nothing is rendered. `text` is plain text.
import type { TocItem } from "../../lib/blog-types";
interface Props { toc: readonly TocItem[]; label: string }
const { toc, label } = Astro.props;
---
{toc.length >= 2 && (
  <nav class="toc" aria-label={label}>
    <p class="h mono">{label}</p>
    <ol>
      {toc.map((item) => <li class={`l${item.level}`}><a href={`#${item.id}`}>{item.text}</a></li>)}
    </ol>
  </nav>
)}
<style>
  .toc { font-size: 14px; }
  .h { font-size: 12px; color: var(--faint); text-transform: uppercase; letter-spacing: .08em; }
  ol { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; border-left: 1px solid var(--line); }
  li { padding-left: 14px; min-width: 0; }
  li.l3 { padding-left: 28px; }
  a { color: var(--muted); overflow-wrap: anywhere; }
  a:hover { color: var(--ink); }
</style>
