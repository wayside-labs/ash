---
// /pitch and /pt/pitch are the pitch decks in public/pitch-deck/, framed so the address stays on
// ash.app.br. The page's language picks the deck; #2-pt and #2-en (the links already sent) pick it
// regardless of the page. Hashes never reach the server, so that switch lives here, in the page.
import { otherLang, type Lang } from "../../content/copy";
interface Props { lang: Lang; alt: string }
const { lang, alt } = Astro.props;
const other = otherLang(lang);
---
<div class="deck-frame">
  <a class="lang mono" href={alt} hreflang={other === "pt" ? "pt-BR" : "en"}>{other.toUpperCase()}</a>
  <iframe title="Ash pitch deck" loading="eager" src={`/pitch-deck/${lang}.html`} data-deck-iframe></iframe>
</div>
<script>
  const decks: Record<string, string> = { "#2-pt": "/pitch-deck/pt.html", "#2-en": "/pitch-deck/en.html" };
  const frame = document.querySelector<HTMLIFrameElement>("[data-deck-iframe]");

  function sync() {
    const src = decks[location.hash.toLowerCase()];
    if (frame && src && frame.getAttribute("src") !== src) frame.src = src;
  }

  window.addEventListener("hashchange", sync);
  sync();

  // The deck draws a rail of thumbnails unless it is told it is presenting, which it only tells
  // itself in fullscreen. The page says so instead, and says it again whenever the rail is back
  // (the deck loads late, changes with the hash, and drops the state on leaving fullscreen).
  setInterval(() => {
    const win = frame?.contentWindow;
    const rail = win?.document.querySelector("deck-stage")?.shadowRoot?.querySelector(".rail");
    if (win && rail && win.getComputedStyle(rail).display !== "none") win.postMessage({ __omelette_presenting: true }, location.origin);
  }, 250);

  // The deck handles its own keys, but only once focus is inside the frame. A key pressed on the
  // page is handed over, so the arrows work without a click first and the skip link stays the
  // first stop of the keyboard.
  const KEYS = new Set(["ArrowRight", "ArrowLeft", "PageDown", "PageUp", "Home", "End", " "]);
  document.addEventListener("keydown", (e) => {
    if (!KEYS.has(e.key) || e.metaKey || e.ctrlKey || e.altKey) return;
    const win = frame?.contentWindow as (Window & typeof globalThis) | null | undefined;
    if (!win) return;
    e.preventDefault();
    win.focus();
    const to = win.document.activeElement ?? win.document.body;
    to.dispatchEvent(new win.KeyboardEvent("keydown", { key: e.key, code: e.code, bubbles: true }));
  });
</script>
<style>
  .deck-frame { position: fixed; inset: 0; background: #0b0c0a; }
  .deck-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .lang {
    position: absolute; top: 10px; right: 12px; z-index: 1; font-size: 12px; color: var(--muted); text-decoration: none;
    border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 5px 8px;
  }
  .lang:hover { color: var(--settle); border-color: var(--settle-line); }
</style>
