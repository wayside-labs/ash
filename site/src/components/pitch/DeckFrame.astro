---
// /pitch#2-pt and /pitch#2-en show the full pitch decks (public/pitch-deck/) over the page, so the
// address stays on ash.app.br. Hashes never reach the server, so the switch lives here, in the page.
import type { Lang } from "../../content/copy";
interface Props { lang: Lang }
const { lang } = Astro.props;
const close = lang === "pt" ? "Fechar" : "Close";
---
<div class="deck-frame" data-deck-frame hidden>
  <button type="button" class="close mono" data-deck-close aria-label={close}>{close} ×</button>
  <iframe title="Ash pitch deck" loading="eager" data-deck-iframe></iframe>
</div>
<script>
  const decks: Record<string, string> = { "#2-pt": "/pitch-deck/pt.html", "#2-en": "/pitch-deck/en.html" };
  const box = document.querySelector<HTMLElement>("[data-deck-frame]");
  const frame = document.querySelector<HTMLIFrameElement>("[data-deck-iframe]");
  const closer = document.querySelector<HTMLButtonElement>("[data-deck-close]");

  function sync() {
    if (!box || !frame) return;
    const src = decks[location.hash.toLowerCase()];
    if (!src) {
      box.hidden = true;
      frame.removeAttribute("src");
      return;
    }
    if (frame.getAttribute("src") !== src) frame.src = src;
    box.hidden = false;
  }

  window.addEventListener("hashchange", sync);
  closer?.addEventListener("click", () => {
    history.replaceState(null, "", location.pathname + location.search);
    sync();
  });
  sync();
</script>
<style>
  .deck-frame { position: fixed; inset: 0; z-index: 1000; background: #0b0c0a; }
  .deck-frame[hidden] { display: none; }
  .deck-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .close {
    position: absolute; top: 10px; right: 12px; z-index: 1; font-size: 12px; color: var(--muted);
    background: transparent; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 5px 8px; cursor: pointer;
  }
  .close:hover { color: var(--settle); border-color: var(--settle-line); }
</style>
