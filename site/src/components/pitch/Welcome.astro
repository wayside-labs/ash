---
import { getPitch } from "../../content/pitch";
import { getCopy, type Lang } from "../../content/copy";
interface Props { lang: Lang }
const { lang } = Astro.props;
const w = getPitch(lang).welcome;
const scene = getCopy(lang).hero.scene;
---
<section class="welcome" data-welcome hidden
  data-hi={w.hi} data-back={w.back} data-treasury={w.treasury}
  data-lines={JSON.stringify(w.lines)} data-scene-labels={JSON.stringify(scene)}>
  <div class="text">
    <h1 data-hi-text tabindex="-1"></h1>
    <p class="line" data-line></p>
    <p class="owner muted">{w.owner}</p>
    <button type="button" class="btn btn-primary" data-open-deck>{w.cta}</button>
  </div>
  <div class="scene"><canvas tabindex="0" role="img" data-welcome-canvas></canvas></div>
</section>
<style>
  .welcome {
    min-height: calc(100svh - 58px); display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px;
    align-items: center; padding: 24px clamp(16px, 6vw, 88px);
  }
  .welcome[hidden] { display: none; }
  .text > * { animation: rise .7s cubic-bezier(.2,.7,.2,1) both; }
  .text > :nth-child(2) { animation-delay: .12s; } .text > :nth-child(3) { animation-delay: .24s; } .text > :nth-child(4) { animation-delay: .36s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  h1 { font-size: clamp(40px, 7vw, 96px); line-height: 1; letter-spacing: -0.025em; outline: none; }
  .line { margin-top: 24px; font-size: clamp(18px, 2vw, 24px); line-height: 1.4; max-width: 30em; }
  .owner { margin-top: 18px; font-size: 15px; }
  .btn { margin-top: 28px; }
  .scene {
    aspect-ratio: 5 / 4; width: 100%; border: 1px solid var(--line-strong); border-radius: var(--radius-xl);
    background: var(--surface); touch-action: none; overflow: hidden; animation: rise .8s cubic-bezier(.2,.7,.2,1) .3s both;
  }
  canvas { width: 100%; height: 100%; display: block; cursor: ns-resize; }
  @media (max-width: 860px) { .welcome { grid-template-columns: 1fr; gap: 32px; padding-block: 32px; } }
  @media (prefers-reduced-motion: reduce) { .text > *, .scene { animation: none; } }
</style>
