---
// Three agent cards from the Claude Design workflow panel v2: one budget each, and the last thing
// that happened to it. The three outcomes are the three answers the program can give.
import type { Lang } from "../../content/copy";
import { getPitch } from "../../content/pitch";
// "lane" is the deck's row with connectors; "grid" is the home's panel, where the cards share the
// width and stack on a narrow screen (the lane cut the third card off on a tablet).
interface Props { lang: Lang; variant?: "lane" | "grid" }
const { lang, variant = "lane" } = Astro.props;
const c = getPitch(lang).cards;
const loc = lang === "pt" ? "pt-BR" : "en-US";
const num = (n: number) => n.toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const nums = [
  { left: 55, limit: 80, bal: 150, state: "settled", amount: 9.4 },
  { left: 6, limit: 50, bal: 500, state: "denied", amount: 12 },
  { left: 22, limit: 30, bal: 75, state: "paused", amount: 0 },
] as const;
const cards = c.items.map((it, i) => ({ ...it, ...nums[i]! }));
---
<div class={variant}>
  {cards.map((k, i) => (
    <>
      {variant === "lane" && i > 0 && <span class="conn" aria-hidden="true"></span>}
      {/* The first card is the one the home's "run a payment" button moves: data-sim marks it and
          its figures, and carries the starting numbers the script counts from. */}
      <article class={`card is-${k.state}`} data-sim={i === 0 ? "" : undefined} data-left={i === 0 ? k.left : undefined} data-limit={i === 0 ? k.limit : undefined} data-bal={i === 0 ? k.bal : undefined} data-amount={i === 0 ? k.amount : undefined}>
        <header><span><b>{k.n}</b><small>{k.r}</small></span><span class={`st ${k.state}`}>{k.status}</span></header>
        <p class="mono money"><b data-sim-left>{num(k.left)}</b> <em>{c.left}</em><span class="accent">{num(k.limit)}</span></p>
        <div class={`bar${k.left / k.limit < 0.15 ? " hot" : ""}`}><i data-sim-bar style={`width:${(1 - k.left / k.limit) * 100}%`}></i></div>
        <p class="row"><span class="faint">{c.balance}</span><span class="mono" data-sim-bal>{num(k.bal)}</span></p>
        <p class="row pays"><span class="faint">{c.pays}</span>{k.pays.map((p) => <span class="chip">{p}</span>)}</p>
        <footer class={`last ${k.state}`}><span class="dot"></span><span><span>{k.last}</span><span data-sim-times></span></span>{k.amount > 0 && <span class="mono amt" data-sim-amount>{num(k.amount)}</span>}</footer>
      </article>
    </>
  ))}
</div>
<style>
  .lane { display: flex; align-items: stretch; overflow-x: auto; padding-bottom: 4px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; }
  .bar i { transition: width .5s; }
  .card { flex: 0 0 min(280px, 78vw); background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-xl); padding: 16px; display: grid; gap: 10px; }
  .card.is-settled { border-color: color-mix(in srgb, var(--settle) 50%, transparent); }
  .card.is-denied { border-color: color-mix(in srgb, var(--deny) 50%, transparent); }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  header b { font-size: 16px; font-weight: 600; } header small { display: block; font-size: 12.5px; color: var(--faint); }
  .st { font-family: var(--mono); font-size: 11px; border: 1px solid; border-radius: var(--radius-sm); padding: 2px 8px; white-space: nowrap; }
  .st.settled, .st.denied { color: var(--settle); border-color: var(--settle-line); }
  .st.paused { color: var(--warning); border-color: color-mix(in srgb, var(--warning) 40%, transparent); }
  .money { display: flex; align-items: baseline; gap: 6px; margin: 0; font-size: 13px; }
  .money b { font-size: 18px; font-weight: 500; } .money em { font-style: normal; color: var(--muted); } .money .accent { margin-left: auto; }
  .accent { color: var(--accent); } .faint { color: var(--faint); }
  .bar { position: relative; height: 3px; background: var(--line-strong); border-radius: 2px; }
  .bar::after { content: ""; position: absolute; right: 0; top: -3px; width: 2px; height: 9px; background: var(--accent); }
  .bar i { display: block; height: 100%; background: var(--settle); border-radius: 2px; box-shadow: var(--glow-bar); }
  .bar.hot i { background: var(--warning); box-shadow: 0 0 10px color-mix(in srgb, var(--warning) 60%, transparent); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin: 0; font-size: 12.5px; flex-wrap: wrap; }
  .pays { justify-content: flex-start; }
  .chip { font-size: 11.5px; background: var(--elevated); color: var(--code-fg); border-radius: var(--radius-sm); padding: 2px 8px; }
  .last { display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--line); padding-top: 10px; font-size: 12.5px; }
  .last .dot { width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .last.settled .dot { background: var(--settle); } .last.denied { color: var(--deny-soft); } .last.denied .dot { background: var(--deny); }
  .last.paused .dot { background: var(--warning); } .amt { margin-left: auto; color: var(--muted); }
  /* The connector: a short dashed run between cards, in the neutral line colour. */
  .conn { flex: 0 0 36px; align-self: center; border-top: 1px dashed var(--line-strong); }
</style>
