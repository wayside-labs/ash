# Copie para .env; nunca commite o .env.
# Vazio de propósito: o build publica esses valores em todos os botões do site. Um valor de
# exemplo aqui vira um link quebrado no ar (aconteceu em 29/09). Preencha só com o real.
PUBLIC_BOOKING_URL=
PUBLIC_CONTACT_EMAIL=
# WhatsApp do "vamos conversar" no fim do /investidor: só dígitos com DDI, ex. 5511900000000.
PUBLIC_WHATSAPP=
# Chave pública (site key) do widget Turnstile do /investor. A secreta fica na Pages
# (TURNSTILE_SECRET), nunca aqui.
PUBLIC_TURNSTILE_SITEKEY=
