[Unit]
Description=ash-studio - teste semanal de restauracao do dump mais recente
After=docker.service
Requires=docker.service
OnFailure=ash-alerta@%n.service

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/bin/bash /opt/ash-studio/backup/restore-test.sh
StandardOutput=append:/var/log/ash-studio-restauracao.log
StandardError=append:/var/log/ash-studio-restauracao.log
