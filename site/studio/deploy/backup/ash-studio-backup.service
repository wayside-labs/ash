[Unit]
Description=ash-studio - dump diario do banco e dos uploads
After=docker.service
Requires=docker.service
OnFailure=ash-alerta@%n.service

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/bin/bash /opt/ash-studio/backup/backup.sh
StandardOutput=append:/var/log/ash-studio-backup.log
StandardError=append:/var/log/ash-studio-backup.log
