# Exemplo para desenvolvimento local: copie para .env.local e troque os valores.
# Nenhum valor aqui é real. O arquivo de produção fica só na VPS (/opt/ash-studio/.env).
# src/lib/env.test.ts confere que toda variável lida por src/lib/env.ts aparece aqui.

# development | test | production. Ausente vale production.
NODE_ENV=development

# Postgres do estúdio.
DATABASE_URL=postgres://studio:troque-esta-senha@127.0.0.1:5432/studio

# Só o nome do host, sem esquema, porta ou barra. "localhost" só vale em development.
STUDIO_HOST=localhost
PUBLIC_HOST=pub.localhost

# Cloudflare Access: domínio do time e a audience (AUD) da aplicação.
ACCESS_TEAM_DOMAIN=seu-time.cloudflareaccess.com
ACCESS_AUD=cole-aqui-a-aud-da-aplicacao

# E-mails dos admins, separados por vírgula.
STUDIO_ADMINS=voce@example.com

# Só em development: entra como este admin sem passar pelo Access. Fora disso o app recusa.
STUDIO_DEV_ADMIN=voce@example.com

# none | mock | smtp. "none" até o M3.
EMAIL_DRIVER=none

# Em produção o deploy preenche com o commit.
APP_VERSION=dev

# Pasta das imagens dos posts, relativa ao diretório do processo.
UPLOADS_DIR=uploads

# Fuso IANA em que o admin pensa ao agendar. Ainda sem uso: quem lê é a tela do M1b.
PUBLISH_TZ=America/Sao_Paulo

# Token que dispara o rebuild do site. Vazio = rebuild desligado.
GITHUB_DISPATCH_TOKEN=
# Repositório (dono/nome) que recebe o repository_dispatch.
GITHUB_DISPATCH_REPO=lglucas/ash-web

# Não preencha: na VPS o compose passa "on" ao app quando o token existe.
SITE_REBUILD=

# As duas abaixo não são lidas por src/lib/env.ts: são do deploy/docker-compose.yml, na VPS.
# DB_PASSWORD=troque-esta-senha
# WORKER_NAME=ash-studio-worker
