# Environment for `agent-rails-vendor serve`. Only public keys: a vendor holds no secret.
AGENT_RAILS_RPC=https://api.devnet.solana.com

# Receiving wallets. One wallet for all three is fine for a demo; three separate ones make
# the explorer view and the allowlist tell you which vendor was paid.
# Each needs >= 0.00089 SOL already (rent-exempt minimum) or small payments to it fail.
ORACLE_PAY_TO=
NOTARY_PAY_TO=
COMPUTE_PAY_TO=

# Prices in human units of the mint (SOL by default).
# ORACLE_PRICE=0.0001
# NOTARY_PRICE=0.0005
# COMPUTE_PRICE=0.001
# COMPUTE_CREDITS_PER_PACK=10

# Labels the operator allowlists each wallet under (`agent-rails dest add --label …`).
# ORACLE_DESTINATION_LABEL=vendor-oracle
# NOTARY_DESTINATION_LABEL=vendor-notary
# COMPUTE_DESTINATION_LABEL=vendor-compute

# mock = never call CoinGecko (deterministic prices, labelled source: "mock").
# ORACLE_SOURCE=mock
# VENDOR_DATA_DIR=~/.agent-rails/vendors
# VENDOR_HOST=127.0.0.1
