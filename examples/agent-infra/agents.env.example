# Copy to agents.env (gitignored pattern: keep it out of the repo) and fill in.
# Everything here is public except the file the SIGNER path points at.

ASH_RPC=https://api.devnet.solana.com
# AgentSession PDA printed by `ash session create` / `init`.
ASH_SESSION=
# Session keypair (0600). The only secret an agent run touches.
ASH_SIGNER=~/.ash/session.json
# Optional separate fee payer; defaults to the session key.
# ASH_FEE_PAYER=

# Vendor endpoints. Local: `pnpm vendors` serves all three on these ports.
ORACLE_URL=http://127.0.0.1:4101
NOTARY_URL=http://127.0.0.1:4102
COMPUTE_URL=http://127.0.0.1:4103

# Optional: report to the operator dashboard and search its knowledge base (ADR-022). Take
# both from Reviews → Agent reporting, or from an exported runner bundle.
# ASH_INGEST_URL=http://127.0.0.1:3000/api/ingest
# ASH_INGEST_TOKEN=
# AGENT_NAME=researcher

# Model for `claude -p`: opus | sonnet | haiku. Haiku is the cheap choice for soak runs.
AGENT_MODEL=sonnet
# Hard ceiling on one run's turns, so a confused agent cannot loop on tool calls.
AGENT_MAX_TURNS=25
