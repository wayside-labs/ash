# Copy to ~/.ash/dca/dca.env (never commit the copy). dca-cron.sh sources it.
# Everything here identifies a treasury and a key file; nothing here is a key.

ASH_RPC=https://api.devnet.solana.com
OUT_DIR=${HOME}/.ash/dca

# From `pnpm ash init --out ~/.ash/dca …` (printed, and in ${OUT_DIR}/devnet.json).
TREASURY=
POLICY_NAME=dca-usdc

# From `pnpm ash session create --out ~/.ash/dca --label dca …`.
SESSION=
SESSION_KEYPAIR=${OUT_DIR}/dca-session-keypair.json

# Pays transaction fees only. `pay` signs the transfer with the session key, never this one.
FEE_PAYER_KEYPAIR=${OUT_DIR}/fee-payer-keypair.json
# Passed as --wallet for context loading; the fee payer is enough.
WALLET=${FEE_PAYER_KEYPAIR}

# The USDC mint the treasury accepts. On devnet, the --mock-mint `init` created
# (see ${OUT_DIR}/devnet.json); on mainnet it would be EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
MINT=

# Allowlisted label of the swap desk wallet (see README: the swap happens from there).
DESTINATION=dca-desk
# Human units per period.
AMOUNT=5

# daily | weekly | hourly. Part of the payment reference, so one period can settle once.
CADENCE=daily
# Prefix of the payment reference: <prefix>/<period>, e.g. dca-usdc/2026-10-01.
REFERENCE_PREFIX=dca-usdc

SINK=${OUT_DIR}/dca.jsonl

# Optional: POSTed on any outcome other than settled or already-settled.
# ALERT_WEBHOOK_URL=
