{
  "mcpServers": {
    "agent-rails": {
      "command": "npx",
      "args": ["-y", "@agent-rails/mcp"],
      "env": {
        "AGENT_RAILS_RPC": "https://api.devnet.solana.com",
        "AGENT_RAILS_SESSION": "<session PDA from `session create --label rebal-<proposal-id>`>",
        "AGENT_RAILS_SIGNER": "~/.agent-rails/yield/rebal-<proposal-id>-session-keypair.json",
        "AGENT_RAILS_FEE_PAYER": "~/.agent-rails/yield/fee-payer-keypair.json",
        "AGENT_RAILS_MINT_ALIASES": "USDC:<MOCK_USDC_MINT>",
        "AGENT_RAILS_SECURITY": "strict",
        "AGENT_RAILS_MAX_PAYMENTS_PER_MINUTE": "2",
        "AGENT_RAILS_SINK": "~/.agent-rails/yield/payments.jsonl",
        "AGENT_RAILS_ALERT_WEBHOOK_URL": "<optional: https webhook for payment_denied>"
      }
    }
  }
}
