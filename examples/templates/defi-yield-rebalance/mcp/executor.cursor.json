{
  "mcpServers": {
    "ash": {
      "command": "npx",
      "args": ["-y", "@ash/mcp"],
      "env": {
        "ASH_RPC": "https://api.devnet.solana.com",
        "ASH_SESSION": "<session PDA from `session create --label rebal-<proposal-id>`>",
        "ASH_SIGNER": "~/.ash/yield/rebal-<proposal-id>-session-keypair.json",
        "ASH_FEE_PAYER": "~/.ash/yield/fee-payer-keypair.json",
        "ASH_MINT_ALIASES": "USDC:<MOCK_USDC_MINT>",
        "ASH_SECURITY": "strict",
        "ASH_MAX_PAYMENTS_PER_MINUTE": "2",
        "ASH_SINK": "~/.ash/yield/payments.jsonl",
        "ASH_ALERT_WEBHOOK_URL": "<optional: https webhook for payment_denied>"
      }
    }
  }
}
