{
  "mcpServers": {
    "ash": {
      "command": "ash-mcp",
      "args": [],
      "env": {
        "ASH_RPC": "https://api.devnet.solana.com",
        "ASH_SESSION": "<SESSION_PDA>",
        "ASH_SIGNER": "<SESSION_KEYPAIR_PATH>",
        "ASH_TOOLS": "full",
        "ASH_SECURITY": "strict"
      }
    },
    "solana-jupiter": {
      "command": "ash-integrations",
      "args": ["mcp", "jupiter"],
      "env": {
        "JUPITER_API_BASE": "https://quote-api.jup.ag"
      }
    },
    "sodax": {
      "command": "ash-integrations",
      "args": ["mcp", "sodax"],
      "env": {
        "SODAX_ALLOWED_DESTINATIONS": "<chainKey>:<address>,<chainKey>:<address>"
      }
    }
  }
}
