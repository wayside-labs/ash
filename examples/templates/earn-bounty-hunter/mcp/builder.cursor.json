{
  "mcpServers": {
    "ash": {
      "command": "npx",
      "args": ["-y", "@ash/mcp"],
      "env": {
        "ASH_RPC": "https://api.devnet.solana.com",
        "ASH_SESSION": "<session PDA from `session create --label earn-<bounty-slug>`>",
        "ASH_SIGNER": "~/.ash/earn/<label>-session-keypair.json",
        "ASH_FEE_PAYER": "~/.ash/earn/fee-payer-keypair.json",
        "ASH_SECURITY": "balanced",
        "ASH_SINK": "~/.ash/earn/payments.jsonl",
        "ASH_ALERT_WEBHOOK_URL": "<optional: https webhook for payment_denied>"
      }
    }
  }
}
