{
  "name": "agent-rails",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "test": "turbo run test",
    "verify": "scripts/verify.sh",
    "agent-rails": "node packages/cli/dist/cli.js",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "idl:build": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$PWD/target}\" NO_DNA=1 anchor idl build -p agent_rails -o idl/agent_rails.json -- --lib --features idl-build",
    "codegen": "pnpm --filter @agent-rails/client run codegen",
    "idl:sync": "pnpm idl:build && pnpm codegen && pnpm build",
    "codegen:check": "pnpm codegen && git diff --exit-code packages/client/src/generated",
    "coverage": "turbo run coverage",
    "guardian-watch": "node --experimental-strip-types scripts/guardian-watch.ts",
    "test:guardian-watch": "node --experimental-strip-types --test scripts/guardian-roll-window.test.ts",
    "dashboard": "pnpm --filter @agent-rails/dashboard dev",
    "dashboard:build": "pnpm --filter @agent-rails/dashboard build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.1.14",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
