[Unit]
Description=Agent Rails dashboard (Next.js)
After=network-online.target agent-rails-supabase.service
Wants=network-online.target

[Service]
Type=simple
User=agent-rails
Group=agent-rails
# `current` is a symlink swapped by deploy.sh; systemd resolves it at start, so a restart is
# what moves the service to a new release.
WorkingDirectory=/srv/agent-rails/current/packages/dashboard
# systemd reads both files as root before dropping to `agent-rails`, which is why the secret one
# can stay root:root 0600 and still reach the process.
EnvironmentFile=/etc/agent-rails/dashboard.public.env
EnvironmentFile=/etc/agent-rails/dashboard.env
Environment=NODE_ENV=production
Environment=AGENT_RAILS_HOME=/var/lib/agent-rails
# Called directly rather than through `pnpm start`: corepack would resolve pnpm on every
# restart and needs a writable cache the sandbox below does not grant.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/agent-rails/releases /var/lib/agent-rails
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
