# Installed to /etc/caddy/Caddyfile by bootstrap.sh, which replaces __DOMAIN__.
# The headers mirror packages/dashboard/vercel.json so the cutover changes nothing a browser
# can observe. Caddy is the only listener on 80/443; the dashboard stays on 127.0.0.1:3000.

__DOMAIN__ {
	encode zstd gzip

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:3000
}
