# /etc/agent-rails/tunnel.env — root:root 0600. The token of the agent-rails tunnel, which Lucas
# creates in the ash Cloudflare account (one tunnel per project). Its public hostnames are set
# there, not here:
#   console.ash.app.br      → http://127.0.0.1:3000   (dashboard)
#   console-api.ash.app.br  → http://127.0.0.1:8000   path ^/(auth|rest)/v1/ only (Supabase)
# Anything else on console-api must fall through to 404: Studio and pg-meta stay on loopback.
TUNNEL_TOKEN=
