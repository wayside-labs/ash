# /etc/agent-rails/dashboard.public.env — root:agent-rails 0640, filled by bootstrap.sh.
# Read by the build (NEXT_PUBLIC_* are inlined into the browser bundle, so they must exist at
# build time) and by the service. Nothing here is secret: all of it ships to every browser.
# The browser talks to Supabase Auth directly, hence the public API hostname.
NEXT_PUBLIC_SUPABASE_URL=https://__API_DOMAIN__
NEXT_PUBLIC_SUPABASE_ANON_KEY=
