# /etc/agent-rails/dashboard.public.env — root:agent-rails 0640, filled by bootstrap.sh.
# Read by the build (NEXT_PUBLIC_* are inlined into the browser bundle, so they must exist at
# build time) and by the service. Nothing here is secret: all of it ships to every browser.
# The browser talks to Supabase Auth directly, hence the public API hostname.
NEXT_PUBLIC_SUPABASE_URL=https://__API_DOMAIN__
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private payout template (ADR-027): mainnet, from the operator's own wallet, off unless set.
# Public like everything in this file; the wallet list fails closed (empty allows nobody).
# NEXT_PUBLIC_CLOAK_MAINNET=1
# NEXT_PUBLIC_CLOAK_ALLOWED_WALLETS=
# NEXT_PUBLIC_CLOAK_RPC_URL=
# The operator's contacts, a JSON object of name to address. The chat may only pay these names;
# the card refuses any payee that is not listed here with the same address. Empty pays nobody.
# NEXT_PUBLIC_CLOAK_CONTACTS={"Supplier A": "<address>", "Contributor B": "<address>"}
