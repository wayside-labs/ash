# Self-hosted Supabase (trimmed) and the agent-rails Cloudflare tunnel, as one compose project.
# Root-owned on purpose: running compose needs the docker socket, which is root-equivalent, and
# ADR-019 keeps every person and service user out of the docker group. So root runs it, and only
# from files root owns (/srv/agent-rails/supabase is root:root 0750).
[Unit]
Description=Agent Rails Supabase stack and tunnel
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/agent-rails/supabase
Environment=COMPOSE=/usr/bin/docker compose -p agent-rails -f docker-compose.yml -f docker-compose.agent-rails.yml --env-file /etc/agent-rails/supabase.env
# First start pulls ~1 GB of images.
TimeoutStartSec=900
ExecStart=/bin/sh -c '$COMPOSE up -d --wait'
# The tunnel comes up only after the gateway has been probed; a failed probe fails the unit and
# leaves everything on loopback.
ExecStartPost=/srv/agent-rails/supabase/check-gateway.sh
# No token yet (fresh bootstrap) means the stack runs private, which is a valid state.
ExecStartPost=/bin/sh -c 'if grep -q "^TUNNEL_TOKEN=." /etc/agent-rails/tunnel.env; then $COMPOSE --profile tunnel up -d tunnel; else echo "no tunnel token: stack stays on loopback"; fi'
ExecStop=/bin/sh -c '$COMPOSE --profile tunnel down'

[Install]
WantedBy=multi-user.target
