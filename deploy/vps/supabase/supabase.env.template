# /etc/agent-rails/supabase.env — root:root 0600, written once by bootstrap.sh from this template.
# Built from our own list rather than upstream's .env.example: that file ships demo values for
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY that its generate-keys.sh never replaces, and a
# public demo secret key would be service_role for anyone who read the docs.
# __GENERATED__ values come from upstream's utils/generate-keys.sh on the VPS; they never leave it.

# --- secrets ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATED__
JWT_SECRET=__GENERATED__
ANON_KEY=__GENERATED__
SERVICE_ROLE_KEY=__GENERATED__
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=__GENERATED__
SECRET_KEY_BASE=__GENERATED__
VAULT_ENC_KEY=__GENERATED__
PG_META_CRYPTO_KEY=__GENERATED__
# Legacy key mode only (the dashboard uses ANON_KEY / SERVICE_ROLE_KEY). Envoy enables sb_ key
# translation only when all four are set; empty keeps it off.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

# --- URLs ---------------------------------------------------------------------------------------
# API_DOMAIN must be one label under the zone: Cloudflare's Universal SSL covers *.ash.app.br but
# not *.console.ash.app.br, so api.console.ash.app.br would have no certificate.
SUPABASE_PUBLIC_URL=https://__API_DOMAIN__
API_EXTERNAL_URL=https://__API_DOMAIN__/auth/v1
SITE_URL=https://__DOMAIN__
ADDITIONAL_REDIRECT_URLS=https://__DOMAIN__/auth/callback
# Loopback only; the tunnel is the one way in.
API_GW_HTTP_PORT=127.0.0.1:8000
KONG_HTTP_PORT=127.0.0.1:8000

# --- auth ---------------------------------------------------------------------------------------
# Same providers as hosted: Google and Solana web3 (the override turns web3 on). Email and phone
# stay off — the dashboard never offers them, so they would only be attack surface.
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
# The hosted project's Google OAuth client; add https://<API_DOMAIN>/auth/v1/callback to its
# authorized redirect URIs before the cutover. Off until both values are in, so a first boot
# without them cannot trip GoTrue's provider validation.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
SMTP_ADMIN_EMAIL=admin@__DOMAIN__
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Agent Rails
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# --- database / PostgREST / Studio ------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
STUDIO_DEFAULT_ORGANIZATION=Agent Rails
STUDIO_DEFAULT_PROJECT=agent-rails
OPENAI_API_KEY=

# --- services left off by the override (profile `unused`) --------------------------------------
# Referenced by upstream's compose file, so defined to keep interpolation quiet; nothing runs them.
REALTIME_DB_ENC_KEY=
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=agent-rails
POOLER_DB_POOL_SIZE=5
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=false
