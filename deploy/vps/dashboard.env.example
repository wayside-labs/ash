# /etc/agent-rails/dashboard.env — root:root 0600, filled by bootstrap.sh. Read only by systemd,
# never by the build. The service role key is the local stack's (supabase.env), not hosted's.
SUPABASE_SERVICE_ROLE_KEY=
# In production allowedOrigins() returns exactly this list; empty means every write is 403.
ALLOWED_ORIGINS=https://__DOMAIN__
# Optional. Without it a visitor with no key of their own gets `demo` (ADR-017).
# ANTHROPIC_API_KEY=
# Optional. Lets the chat's `claude-cli` provider run on this box: install the CLI where
# systemd's PATH finds it (`sudo npm i -g @anthropic-ai/claude-code` → /usr/local/bin), then
# paste the token `claude setup-token` prints on your own machine. It is your subscription:
# every visitor who can reach the chat spends it, so keep it behind the owner's login.
# CLAUDE_CODE_OAUTH_TOKEN=
# Where agents reach this dashboard (the runner export compiles `<this>/api/ingest` into their
# MCP env). Required behind the tunnel: the request origin the app sees is 127.0.0.1:3000.
DASHBOARD_PUBLIC_URL=https://__DOMAIN__
# Optional. Semantic knowledge search; without it documents are indexed by keyword (BM25).
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite
# Optional. Email notification channels (Settings → Notification channels).
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=Agent Rails <alerts@__DOMAIN__>
