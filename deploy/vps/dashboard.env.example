# /etc/agent-rails/dashboard.env — root:root 0600, filled by bootstrap.sh. Read only by systemd,
# never by the build. The service role key is the local stack's (supabase.env), not hosted's.
SUPABASE_SERVICE_ROLE_KEY=
# In production allowedOrigins() returns exactly this list; empty means every write is 403.
ALLOWED_ORIGINS=https://__DOMAIN__
# Optional. Without it a visitor with no key of their own gets `demo` (ADR-017).
# ANTHROPIC_API_KEY=
