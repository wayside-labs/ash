# /etc/agent-rails/dashboard.env — root:root 0600. Read only by systemd, never by the build.
SUPABASE_SERVICE_ROLE_KEY=
# In production allowedOrigins() returns exactly this list; empty means every write is 403.
# Keep the Vercel URL here until the cutover is done so both deployments accept writes.
ALLOWED_ORIGINS=https://<domain>,https://agent-rails-virid.vercel.app
# Optional. Without it a visitor with no key of their own gets `demo` (ADR-017).
# ANTHROPIC_API_KEY=
