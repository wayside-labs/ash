# /etc/agent-rails/dashboard.env — root:root 0600, filled by bootstrap.sh. Read only by systemd,
# never by the build. The service role key is the local stack's (supabase.env), not hosted's.
SUPABASE_SERVICE_ROLE_KEY=
# In production allowedOrigins() returns exactly this list; empty means every write is 403.
ALLOWED_ORIGINS=https://__DOMAIN__
# The chat's model. Required for the assistant to answer anyone: hosted, this is the only key the
# server spends, and it is metered against each org's prepaid credit (chat-credit-billing.md).
# Set a spend limit on the key in OpenRouter. Without it visitors get `demo`.
OPENROUTER_API_KEY=
# 2000 = the 20% service fee on top of what OpenRouter charges. 0..10000.
# BILLING_MARKUP_BPS=2000
# Printed in /terms and /privacy. Unset, the pages show a bracketed gap where each belongs.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=
# Deliberately absent: ANTHROPIC_API_KEY and CLAUDE_CODE_OAUTH_TOKEN. Hosted, the server ignores
# the first and never offers the Claude CLI, so setting either does nothing but mislead; the
# second is a personal subscription login, and serving visitors with it is outside Anthropic's
# terms. A key a tenant stores in My APIs is theirs and still works.
# Where agents reach this dashboard (the runner export compiles `<this>/api/ingest` into their
# MCP env). Required behind the tunnel: the request origin the app sees is 127.0.0.1:3000.
DASHBOARD_PUBLIC_URL=https://__DOMAIN__
# Optional. Semantic knowledge search; without it documents are indexed by keyword (BM25).
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite
# Optional. Email notification channels (Settings → Notification channels).
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=Agent Rails <alerts@__DOMAIN__>

# Deposits into the assistant credit (docs/runbooks/chat-credit-billing.md).
# The recipient is a public address; the fee payer is a hot key holding a little SOL.
SOLANA_PAY_RECIPIENT=
SOLANA_PAY_CLUSTER=mainnet-beta
SOLANA_PAY_RPC_URL=
SOLANA_PAY_FEE_PAYER_KEY=
