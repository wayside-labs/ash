# /etc/agent-rails/buyer.env — root:agent-rails 0640. Paths only; the key file itself is
# /var/lib/agent-rails/buyer/session.json, agent-rails:agent-rails 0600.
AGENT_RAILS_RPC=https://api.devnet.solana.com
# The buyer's own session: give it a separate, small policy so it cannot starve the agents.
AGENT_RAILS_SESSION=
# Flags passed through to `agent-rails pay`. The CLI needs the treasury and policy to read
# the allowlist; with no manifest on this box they come from flags.
BUYER_PAY_FLAGS=--rpc https://api.devnet.solana.com --treasury <TREASURY_PDA> --policy-name <POLICY_NAME> --session-keypair /var/lib/agent-rails/buyer/session.json --out /var/lib/agent-rails/buyer
